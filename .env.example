# Register a Microsoft Entra public client application, then copy its IDs here.
OUTLOOK_CLIENT_ID=your-application-client-id
OUTLOOK_TENANT_ID=organizations

# Only messages intentionally moved/routed to this top-level Outlook folder are read.
OUTLOOK_FOLDER=MC News
OUTLOOK_LOOKBACK_DAYS=90
OUTLOOK_REFRESH_HOURS=1

# Optional: select a specific signed-in mailbox when the token cache has several accounts.
OUTLOOK_ACCOUNT=
